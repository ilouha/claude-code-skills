    "new_york_city": {
      "county": "New York City (all boroughs)",
      "state": "NY",
      "assessor_name": "NYC Department of Finance",
      "base_url": "https://a836-pts-access.nyc.gov/care/search/commonsearch.aspx?mode=address",
      "portal_url": "https://a836-pts-access.nyc.gov/care/search/commonsearch.aspx?mode=address",
      "api": {
        "search_endpoint": "https://data.cityofnewyork.us/resource/64uk-42ks.json?$where=address='{address}'%20AND%20borough='{borough_code}'&$limit=5",
        "method": "web_fetch",
        "response_format": "JSON",
        "dataset": "PLUTO (Primary Land Use Tax Lot Output)",
        "resource_id": "64uk-42ks",
        "borough_codes": {
          "Manhattan": "MN",
          "Brooklyn": "BK",
          "Queens": "QN",
          "Bronx": "BX",
          "Staten Island": "SI"
        },
        "notes": "Use NYC Open Data PLUTO API. Address must be UPPERCASE. Borough code is required. Returns comprehensive property data including BBL, lot area, building area, zoning, year built, assessed values, units, stories, historic districts, and special districts. For condos, lot numbers 7501+ are condo-specific lots."
      },
      "search_method": "api",
      "search_workflow": [
        "1. Convert address to UPPERCASE (e.g., '143 GREENE STREET')",
        "2. Determine borough code: MN, BK, QN, BX, or SI",
        "3. web_fetch the PLUTO API endpoint with address and borough_code",
        "4. Parse JSON response — first result is typically the correct match",
        "5. Extract all property fields from the PLUTO record"
      ],
      "field_mappings": {
