        "method": "web_fetch",
        "response_format": "JSON",
        "notes": "Search returns {TotalCount, Parcels[{AIN, SitusStreet, SitusCity, SitusZipCode, LegalDescription}]}. Use first match AIN, then fetch detail endpoint for full data."
