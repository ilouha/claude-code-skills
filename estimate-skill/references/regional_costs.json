        "detroit":            { "multiplier": 1.02 },
        "cleveland":          { "multiplier": 0.98 },
        "columbus":           { "multiplier": 0.95 },
        "indianapolis":       { "multiplier": 0.92 },
        "milwaukee":          { "multiplier": 1.02 },
