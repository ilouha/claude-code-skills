  "soft_costs": {
    "description": "Soft costs as a percentage of hard construction costs",
    "categories": {
      "architect_engineer": {
        "label": "Architect & Engineering Fees",
        "low_pct": 5.0,
        "mid_pct": 8.0,
        "high_pct": 12.0,
        "notes": "5-7% for simple/large; 8-10% for custom/mid; 10-12% for complex/institutional. Includes structural, MEP, civil engineering."
      },
      "permitting_fees": {
        "label": "Permitting & Impact Fees",
        "low_pct": 1.0,
        "mid_pct": 3.0,
        "high_pct": 5.0,
        "notes": "Varies enormously by jurisdiction. California, NYC, Hawaii at high end. Includes plan check, building permit, school impact fees, utility connection fees."
      },
      "contingency": {
        "label": "Contingency",
        "low_pct": 5.0,
        "mid_pct": 10.0,
        "high_pct": 20.0,
        "notes": "5% for well-defined new construction, 10% standard, 15-20% for renovations or early-stage estimates."
      },
      "financing": {
        "label": "Construction Financing / Carry Costs",
        "low_pct": 2.0,
        "mid_pct": 4.0,
        "high_pct": 7.0,
        "notes": "Interest carry during construction; longer projects = higher cost. Includes origination fees and interest reserve."
      },
      "developer_fee": {
        "label": "Developer Fee / Overhead",
        "low_pct": 3.0,
        "mid_pct": 4.0,
        "high_pct": 5.0,
        "notes": "Common in commercial/multifamily projects. Owner-builder projects may not include this."
      },
      "legal_insurance": {
        "label": "Legal, Insurance & Accounting",
        "low_pct": 1.0,
        "mid_pct": 2.0,
        "high_pct": 3.0,
        "notes": "Builder's risk, general liability, legal review, title, accounting"
      },
      "testing_inspections": {
        "label": "Testing & Special Inspections",
        "low_pct": 0.5,
        "mid_pct": 1.0,
        "high_pct": 2.0,
        "notes": "Soils, concrete, steel, special inspections required by code. Higher for institutional/seismic."
      }
    },
    "typical_total_range": {
      "simple_project": "25-30% of hard costs",
      "standard_project": "30-35% of hard costs",
      "complex_project": "35-45% of hard costs"
    }
  },

  "escalation": {
    "description": "Annual construction cost escalation rates (2025 outlook)",
    "national_average_pct": 4.5,
    "high_growth_markets_pct": 6.0,
    "stable_markets_pct": 3.0,
    "high_growth_metros": [
      "austin", "nashville", "phoenix", "raleigh", "boise", "tampa",
      "dallas_fort_worth", "denver", "charlotte", "salt_lake_city"
    ],
    "notes": "Apply escalation to mid-point of construction for future projects. E.g., a project starting in 12 months with 18-month duration: escalate to month 21 (midpoint)."
  }
}
