        "austin":             { "multiplier": 0.97 },
        "phoenix":            { "multiplier": 0.95 },
        "tucson":             { "multiplier": 0.88 },
        "las_vegas":          { "multiplier": 0.98 },
        "albuquerque":        { "multiplier": 0.88 },
