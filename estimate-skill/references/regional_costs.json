{
  "data_vintage": "2025-Q1",
  "currency": "USD",
  "notes": "Base costs are national averages before regional adjustment. Apply the regional multiplier to get location-adjusted cost/SF. All costs are hard costs only — add soft costs separately.",

  "regions": {
    "northeast": {
      "default_multiplier": 1.20,
      "metros": {
        "new_york_city":      { "multiplier": 1.55, "notes": "Manhattan/Brooklyn premium; outer boroughs ~1.35" },
